/* Tailwind CSS directives */
@tailwind base;
@tailwind components;
@tailwind utilities;

/* Глобальні стилі — скидання відступів для повноекранного переглядача */

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

html,
body,
#root {
  width: 100%;
  min-height: 100%;
  font-family: system-ui, Avenir, Helvetica, Arial, sans-serif;
  background-color: var(--background);
  overscroll-behavior: none;
  /* Prevent rubber-banding/chrome hiding on mobile */
}

/* Ensure full height on mobile with dvh */
@supports (height: 100dvh) {
  html,
  body,
  #root {
    height: 100dvh;
  }
}

@layer base {
  :root {
    --background: 0 0% 100%;
    --foreground: 0 0% 3.9%;
