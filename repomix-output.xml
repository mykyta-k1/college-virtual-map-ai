import { useState, useEffect, useCallback } from 'react';
import { useSearchParams } from 'react-router-dom';
import { floorsConfig } from '@/config/floorsConfig';
import MapViewer from '@/components/map/MapViewer';
import type { SearchableRoom } from '@/services/search.service';
import { SearchService } from '@/services/search.service';

/**
 * Сторінка "Мапа" — основний компонент.
 *
 * Оновлений Layout (Full Viewport):
 * - Мапа займає ВЕСЬ доступний простір сторінки (h-full w-full).
 * - Відповідає розміру батьківського контейнера (main в App.tsx).
 * - Обробляє URL параметри ?room=ID та ?search=QUERY.
 * - Синхронізує URL тільки коли відкривається/закривається sidebar з деталями.
 */
export default function MapPage() {
  const [searchParams, setSearchParams] = useSearchParams();
  const [activeFloorId, setActiveFloorId] = useState(1);

  // State to hold initial search query from URL
  const [initialSearchQuery, setInitialSearchQuery] = useState('');
  const [initialRoom, setInitialRoom] = useState<SearchableRoom | null>(null);

  const activeFloor = floorsConfig.find((f) => f.id === activeFloorId) ?? floorsConfig[0];

  // Process URL parameters - reactive to changes
  useEffect(() => {
    // Перевірка параметру search (наприклад, перехід з AI чату або посилання)
    const searchQuery = searchParams.get('search');
    if (searchQuery) {
      // Ініціалізуємо сервіс пошуку для знаходження кімнати
      const searchService = new SearchService(floorsConfig);
      const results = searchService.search(searchQuery);

      if (results.length > 0) {
        const bestMatch = results[0].item;

        // Перевіряємо на точний збіг (наприклад "312" == "312")
        const isExactMatch = bestMatch.label.toLowerCase() === searchQuery.toLowerCase();

        if (isExactMatch) {
          // ТОЧНИЙ ЗБІГ: Вважаємо це прямою навігацією (як клік по кнопці в AI)

          // 1. Перемикаємо поверх, якщо кімната на іншому
          if (bestMatch.floorId) setActiveFloorId(bestMatch.floorId);

          // 2. Вибираємо кімнату (активує синє виділення + сайдбар)
          setInitialRoom(bestMatch);

          // 3. Очищаємо пошуковий запит, щоб прибрати зелене виділення "результату пошуку"
          setInitialSearchQuery('');
          return;
        }

        // ЧАСТКОВИЙ ЗБІГ: Просто допомагаємо користувачу знайти
        // Перемикаємо на поверх з найкращим результатом
        if (bestMatch.floorId) {
          setActiveFloorId(bestMatch.floorId);
        }
        // Не вибираємо кімнату автоматично (вона буде підсвічена зеленим через пошук)
      }

      // Встановлюємо пошуковий запит (активує зелене виділення для всіх результатів)
      setInitialSearchQuery(searchQuery);
      return;
    }

    // Fallback to room parameter (from FAQ)
    const roomId = searchParams.get('room');
    if (roomId) {
      // Find floor for this room
      const floor = floorsConfig.find((f) => f.rooms.some((r) => r.id === roomId));
      if (floor) {
        setActiveFloorId(floor.id);

        // Find the room label to populate search
        const room = floor.rooms.find((r) => r.id === roomId);
        if (room) {
          setInitialRoom({ ...room, floorId: floor.id });
        }
      }
    } else {
      // No URL params - clear initial search
      setInitialSearchQuery('');
    }
  }, [searchParams]); // React to URL changes

  // Handle room selection - updates URL when sidebar opens with room details
  const handleRoomSelect = useCallback(
    (room: SearchableRoom | null) => {
      if (room) {
        // Room selected - sidebar opening - update URL
        setSearchParams({ search: room.label }, { replace: true });
      } else {
        // Room deselected - sidebar closing - clear URL
        setSearchParams({}, { replace: true });
      }
    },
    [setSearchParams],
  );

  return (
    <div className="h-full w-full overflow-hidden bg-background relative">
      <MapViewer
        floor={activeFloor}
        allFloors={floorsConfig}
        onFloorChange={setActiveFloorId}
        onRoomSelect={handleRoomSelect}
        initialSearchQuery={initialSearchQuery}
        initialRoom={initialRoom}
      />
    </div>
  );
}
</file>

<file path="README.md">
# 🗺️ College Virtual Map AI (PWA)

Інноваційний інструмент для навігації студентів, викладачів та гостей коледжу. Цей проект поєднує інтерактивну карту приміщень, розумний пошук та AI-асистента для швидкого орієнтування в навчальному закладі.

## 🎯 Мета проєкту

Створити інтуїтивно зрозуміле середовище, яке допоможе новачкам та гостям коледжу легко знаходити потрібні аудиторії, кафедри, адміністративні кабінети чи зони відпочинку. Проєкт покликаний стати надійним провідником, що зменшує стрес від пошуку локацій у незнайомому просторі, використовуючи сучасні веб-технології та штучний інтелект.

---

## ✨ Основні можливості

*   **🗺️ Інтерактивна карта:** Деталізовані та масштабовані SVG-плани поверхів із чітким позначенням усіх кабінетів.
*   **🔍 Розумний пошук:** Миттєвий пошук аудиторій за номером, назвою або **прізвищем викладача**.
*   **🤖 AI Асистент:** Чат-бот на базі штучного інтелекту, який відповідає на запитання про розташування об'єктів та може автоматично прокладати маршрути або показувати локації на карті.
*   **📍 Побудова маршрутів:** Система навігації, що прокладає найкоротший шлях між двома точками, враховуючи переходи між поверхами.
*   **👀 360° Панорами:** Віртуальні тури по ключових локаціях (холи, великі аудиторії) для кращого орієнтування.
*   **📱 PWA (Progressive Web App):** Можливість встановлення як мобільного додатку, робота офлайн (частково) та швидкий доступ.
*   **ℹ️ Детальна інформація:** Перегляд розкладу викладачів, описів кабінетів та контактної інформації.

---

## 🛠️ Використані технології та джерела

Проєкт побудований на сучасному стеку технологій:

*   **[React](https://react.dev/) + [Vite](https://vitejs.dev/):** Швидкий та ефективний фронтенд фреймворк.
*   **[TypeScript](https://www.typescriptlang.org/):** Для надійності коду та типізації.
*   **[Tailwind CSS](https://tailwindcss.com/) + [Shadcn UI](https://ui.shadcn.com/):** Для створення стильного, адаптивного та доступного інтерфейсу.
*   **[Fuse.js](https://www.fusejs.io/):** Потужний движок для швидкого "нечіткого" пошуку (fuzzy search).
*   **[ngraph](https://github.com/anvaka/ngraph.path):** Бібліотека для роботи з графами та пошуку шляхів (A* алгоритм).
*   **[Pannellum](https://pannellum.org/):** Легковаговий переглядач панорамних зображень.
*   **[Lucide React](https://lucide.dev/):** Набір гарних та послідовних іконок.
*   **[Vaul](https://vaul.emilkowal.ski/):** Компонент "Drawer" для мобільних пристроїв.

---

## 🚀 Як запустити проєкт

### 1. Клонування репозиторію
```bash
git clone <repository-url>
cd college-virtual-map-ai
```

### 2. Встановлення залежностей
```bash
npm install
```

### 3. Налаштування змінних оточення (ОБОВ'ЯЗКОВО)
Створіть файл `.env` або `.env.local` в корені проєкту та вкажіть наступні налаштування:

```env
# URL зовнішнього сервісу AI Worker (для роботи чат-бота)
VITE_AI_WORKER_URL=https://your-ai-worker-service.com/api/chat

# API ключ для доступу до AI сервісу
VITE_AI_API_KEY=your_secure_api_key

# Пошта підтримки (для форми зворотного зв'язку)
VITE_SUPPORT_EMAIL=support@college-map.ai
```

> ⚠️ **Важливо:** Без валідних `VITE_AI_WORKER_URL` та `VITE_AI_API_KEY` функціонал AI чату буде недоступний або працюватиме некоректно. AI чат реалізований як відокремлений мікросервіс без підтримки стрімінгу.

### 4. Запуск у режимі розробки
```bash
npm run dev
```
Відкрийте браузер за адресою `http://localhost:5173` (або іншою, вказаною в консолі).

### 5. Збірка для продакшну
```bash
npm run build
```
Готові файли будуть у папці `dist`.

---

## 📱 Встановлення як додаток (PWA)
Цей сайт можна встановити на телефон або комп'ютер як окремий додаток:
1.  Відкрийте сайт у браузері (Chrome/Safari/Edge).
2.  Натисніть кнопку "Встановити" (або "Додати на домашній екран") в меню браузера.
3.  Користуйтесь додатком без рамок браузера та з швидким запуском.
</file>

